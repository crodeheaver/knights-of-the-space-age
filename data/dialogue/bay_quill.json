  "s_plain": {
   "speaker": "quill",
   "text": "Stand where you are. Marshal Teodor Quill, Lantern Office. You're the escort for the Concord's passengers. And the one the ship calls Custodian, if the Concord's chatter is right.",
   "next": "want"
  },
  "s_message": {
   "speaker": "quill",
   "text": "Stand easy. Marshal Teodor Quill. Senna Thorne sent word ahead. She says an operator let her live. I assume that was you. That buys you my attention.",
   "next": "want",
   "effects": [
    {
     "influence": "iona",
     "delta": 1,
     "key": "quill_msg",
     "reason": "Mercy paid off"
    }
   ]
  },
  "s_killed": {
   "speaker": "quill",
   "text": "Marshal Teodor Quill. My scouts found Senna Thorne in cold storage. You put her down like an animal. Blood for blood, operator. Give me a reason not to.",
   "next": "killed_hub"
  },
  "killed_hub": {
   "speaker": "quill",
   "text": "Speak.",
   "choices": [
    {
     "text": "She was a soldier who boarded a refugee ship. So are you.",
     "next": "fight",
     "tone": "hard"
    },
    {
     "text": "It was a mistake. One I'll carry. Don't make the passengers pay for it.",
     "next": "k_ok",
     "tag": "Persuasion",
     "check": {
      "skill": "persuasion",
      "dc": 20,
      "id": "quill_killed",
      "bonus_if": [
       {
        "if": [
         {
          "item": "kinship_token"
         }
        ],
        "bonus": 4
       },
       {
        "if": [
         {
          "flag": "archive_fate",
          "eq": "handed_over"
         }
        ],
        "bonus": 4
       }
      ]
     },
     "success": "k_ok",
     "failure": "fight"
    },
    {
     "text": "(Seize his will with Resonance.)",
     "next": "compelled",
     "tag": "Resonance",
     "if": [
      {
       "power": "compel"
      }
     ],
     "effects": [
      {
       "alignment": -10,
       "key": "quill_compel",
       "reason": "Forced Quill's will"
      },
      {
       "influence": "iona",
       "delta": -6,
       "key": "quill_compel",
       "reason": "Coerced Quill"
      },
      {
       "influence": "tav7",
       "delta": -6,
       "key": "quill_compel",
       "reason": "Overrode a will"
      }
     ],
     "check": {
      "skill": "persuasion",
      "dc": 16,
      "id": "quill_compel_k",
      "power": "compel",
      "energy": 6
     },
     "success": "compelled",
     "failure": "fight"
    },
    {
     "text": "Tav-7, the apron shield. Now.",
     "next": "tech",
     "tag": "Tav-7 – Computer Use",
     "if": [
      {
       "in_party": "tav7"
      }
     ],
     "check": {
      "skill": "computer_use",
      "dc": 14,
      "id": "quill_tech_k",
      "who": "tav7"
     },
     "success": "tech",
     "failure": "fight"
    }
   ]
  },
  "k_ok": {
   "speaker": "quill",
   "text": "...A mistake. You'll carry it. Then carry it far from here. Go, before I change my mind.",
   "next": "peace"
  },
  "want": {
   "speaker": "quill",
   "text": "We came for our dead. Three thousand of them. Where are they?",
   "choices": [
    {
     "text": "Still in the hold, waiting for you. We're not taking them.",
     "next": "w_left",
     "if": [
      {
       "any": [
        {
         "flag": "archive_fate",
         "eq": "handed_over"
        },
        {
         "flag": "archive_fate",
         "eq": "left"
        }
       ]
      }
     ]
    },
    {
     "text": "Aboard the Petrel. They go to the tribunal on Tessaly.",
     "next": "w_loaded",
     "if": [
      {
       "flag": "archive_fate",
       "eq": "loaded"
      }
     ]
    },
    {
     "text": "Purged. They're gone.",
     "next": "w_purged",
     "if": [
      {
       "flag": "archive_fate",
       "eq": "purged"
      }
     ]
    },
    {
     "text": "I don't know yet.",
     "next": "w_unknown",
     "if": [
      {
       "not": {
        "flag": "archive_fate"
       }
      }
     ]
    }
   ]
  },
  "w_unknown": {
   "speaker": "quill",
   "text": "Then you have not been to launch control. Go, decide, and come back when you can answer me.",
   "end": true
  },
  "w_left": {
   "speaker": "quill",
   "text": "In the hold. Not on your craft. ...Then you and I have no quarrel left. Senna would want me to say that. By the lantern, go.",
   "next": "w_left_more"
  },
  "w_left_more": {
   "redirect": [
    {
