  "a_treat": {
   "speaker": "varga",
   "text": "They're stable. You did that. Now go and do it again for the people in Ward 2.",
   "choices": [
    {
     "text": "We're going.",
     "end": true
    }
   ]
  },
  "a_split": {
   "speaker": "varga",
   "text": "Benedikt asked who you were. I told him you were with security. Seemed simpler.",
   "choices": [
    {
     "text": "Take care of them.",
     "end": true
    }
   ]
  },
  "a_other": {
   "speaker": "varga",
   "text": "I'm working. Unless you've brought me another dose, there's nothing to say.",
   "choices": [
    {
     "text": "(Leave her be.)",
     "end": true
