  "ward_tav2": {
   "speaker": "tav7",
   "text": "The purge valve by the ward door could clear the vapour first. It needs steady hands. Mine are steady.",
   "next": "choose"
  },
  "treat": {
   "speaker": "varga",
   "text": "Then I'll stop talking and work. Go. Get these people a ship to get on.",
   "next": "react_treat"
