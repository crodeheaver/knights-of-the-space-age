  "ward_iona": {
   "speaker": "iona",
   "text": "I sealed it. Varr's order. I stood there eleven seconds deciding whether to be the kind of officer who obeys. I obeyed.",
   "next": "ward_tav"
  },
  "ward_tav": {
   "redirect": [
